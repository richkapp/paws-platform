# Static demo: no database, forms, admin writes or email required.
PUBLIC_API_URL=

# OPTIONAL backend: generate private local credentials with bun run setup:local
# (run that before creating .env; it refuses to overwrite existing files).
DATABASE_URL=
PAWS_ADMIN_EMAIL=
PAWS_ADMIN_PASSWORD_SHA256=
PAWS_SESSION_SECRET=
PAWS_PUBLIC_API_URL=http://127.0.0.1:3314
PAWS_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# Blank means the current project directory. Use an absolute writable path otherwise.
PAWS_PROJECT_ROOT=
PORT=3314

# Both frontend shelter config and this backend switch must opt in.
PAWS_FORM_ENABLED=false
# Leave true for local work. Starting the API never enables delivery by itself.
PAWS_FORM_EMAIL_DRY_RUN=true
PAWS_FORM_RECIPIENT_EMAIL=
PAWS_FORM_FROM_EMAIL=
PAWS_FORM_SMTP_HOST=
PAWS_FORM_SMTP_PORT=587
PAWS_FORM_SMTP_SECURE=false
PAWS_FORM_SMTP_USER=
PAWS_FORM_SMTP_PASSWORD=
